# Terragrunt / Terraform / OpenTofu
.terragrunt-cache/
.terraform/
# NOTE: .terraform.lock.hcl is intentionally NOT ignored — provider lock files
# must be committed so `init` pins identical provider versions/hashes everywhere.
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# Generated by root.hcl into each module dir (never commit)
backend.tf
provider.tf

# Local overrides / secrets
*.auto.tfvars
.env
