# Copy to .env for local (non-Docker) runs.
# URL the Next server uses to reach the backend for /api and /l rewrites.
BACKEND_URL="http://localhost:4000"
# Branded short domain shown in the UI (client-inlined at build time).
NEXT_PUBLIC_SHORT_DOMAIN="sgcut.co"

# Auth: 'demo' (default) or 'cognito' (browser signs in with aws-amplify → Cognito).
NEXT_PUBLIC_AUTH_PROVIDER="demo"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Required only when NEXT_PUBLIC_AUTH_PROVIDER=cognito:
NEXT_PUBLIC_COGNITO_USER_POOL_ID=""
NEXT_PUBLIC_COGNITO_CLIENT_ID=""
NEXT_PUBLIC_COGNITO_DOMAIN=""
