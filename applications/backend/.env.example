# Copy to .env for local (non-Docker) runs. In Docker these come from docker-compose.yml.
DATABASE_URL="postgresql://sgcut:sgcut@localhost:5432/sgcut?schema=public"
PORT=4000
JWT_SECRET="change-me"
FRONTEND_URL="http://localhost:3000"
COOKIE_SECURE=false

# Auth: 'demo' (default httpOnly-cookie session) or 'cognito' (verify Cognito ID token as Bearer).
AUTH_PROVIDER="demo"
# Required only when AUTH_PROVIDER=cognito:
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""
