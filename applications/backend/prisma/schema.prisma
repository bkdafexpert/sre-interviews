// Sgcut — data model for the URL shortener.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  initials  String
  createdAt DateTime @default(now())
  links     Link[]
}

// One row per short link. `id` is the short code shown after the domain (sgcut.co/<id>).
model Link {
  id          String       @id
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination String
  createdAt   DateTime     @default(now())
  expiresAt   DateTime? // null = never expires
  disabledAt  DateTime? // set when the owner manually deactivates the link
  clickEvents ClickEvent[]

  @@index([userId])
}

// One row per redirect. Analytics (sources / devices / countries / time series) are aggregated from these.
model ClickEvent {
  id        String   @id @default(uuid())
  linkId    String
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  source    String // Instagram, Newsletter, LinkedIn, Google, Accès direct, …
  device    String // Mobile, Desktop, Tablette
  country   String // France, Belgique, Suisse, …

  @@index([linkId])
  @@index([createdAt])
}
